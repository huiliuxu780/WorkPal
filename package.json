{
  "name": "workpal",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "^22.22.2 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev-workpal.mjs",
    "agent:doctor": "tsx packages/testkit/src/cli/resources/doctor.ts",
    "dev:app": "cross-env COREPACK_ENABLE_DOWNLOAD_PROMPT=0 turbo dev --filter=@rakazo/api --filter=@rakazo/worker --filter=@rakazo/web --filter=@rakazo/sandbox-supervisor",
    "dev:agentscope": "mvn -q -f services/agent-runtime/pom.xml package -DskipTests && java -jar services/agent-runtime/target/agent-runtime-0.1.0.jar",
    "build": "turbo build",
    "check": "turbo check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "repo:hygiene": "node scripts/ci/check-repo-hygiene.mjs",
    "hooks:install": "node scripts/hooks/install.mjs",
    "db:generate": "pnpm --filter @rakazo/db generate",
    "db:migrate": "pnpm --filter @rakazo/db migrate",
    "sandbox:build": "docker build -t rakazo/computer:local infra/sandboxes/computer",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:postgres": "node scripts/testing/run-test-group.mjs postgres",
    "test:process": "node scripts/testing/run-test-group.mjs process",
    "test:inventory": "node scripts/testing/test-inventory.mjs",
    "test:agentscope": "mvn -q -f services/agent-runtime/pom.xml test",
    "test:compose-smoke": "bash infra/compose/run-smokes.sh",
    "test:integration": "tsx packages/testkit/src/cli/harness.ts --integration",
    "test:e2e": "tsx packages/testkit/src/cli/harness.ts --e2e",
    "test:ci-select": "node --test scripts/ci/*.test.mjs scripts/testing/*.test.mjs",
    "test:docs": "node --test docs/roundtable/*.test.mjs",
    "test:worker-chain": "tsx packages/testkit/src/cli/worker-chain.ts",
    "test:topology": "tsx packages/testkit/src/cli/topology.ts",
    "test:canary": "tsx packages/testkit/src/cli/canary.ts",
    "test:evals": "tsx packages/testkit/src/cli/evals.ts",
    "test:computer-replay": "tsx packages/testkit/src/cli/computer-replay.ts",
    "test:computer": "tsx packages/testkit/src/cli/computer.ts",
    "perf:compare": "tsx packages/testkit/src/cli/compare-performance.ts",
    "compose:up": "docker compose --env-file .env -f infra/compose/docker-compose.yml up --build",
    "compose:down": "docker compose --env-file .env -f infra/compose/docker-compose.yml down -v"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "24.13.3",
    "cross-env": "10.1.0",
    "tsx": "4.23.13",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3"
    }
  }
}
