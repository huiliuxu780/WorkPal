generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AiDataConsent {
  userId String
  spaceId String
  recipientKey String
  version String
  grantedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  spaceMember SpaceMember @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)

  @@id([userId, spaceId, recipientKey])
  @@map("ai_data_consents")
}

model User {
  aiDataConsents AiDataConsent[]
  id                          String                       @id
  name                        String
  email                       String
  emailVerified               Boolean                      @default(false)
  image                       String?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  avatarStyle                 String                       @default("bloub")
  sessions                    Session[]
  accounts                    Account[]
  members                     Member[]
  invitations                 Invitation[]
  modelCredentials            UserModelCredential[]
  voiceCredentials            UserVoiceCredential[]
  secrets                     Secret[]
  mcpServers                  McpServer[]
  botSections                 BotSection[]
  actionApprovalRules         ActionApprovalRule[]
  actionAutoReviewPreferences ActionAutoReviewPreference[]
  createdSpaces               Space[]                      @relation("SpaceCreator")
  botSecrets BotSecret[]
  agentSecrets               AgentSecret[]
  avatarFailureReceipts       AvatarFailureReceipt[]

  @@unique([email])
  @@map("user")
}

model BotAvatarChange {
  id              String    @id @default(cuid())
  botId           String
  bot             Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId          String
  spaceId         String
  source          String
  runId           String?
  operationKey    String?   @unique
  /// Metadata-only marker for a keyed request that was already satisfied.
  /// Never visible in history; keeps a lost-result retry idempotent.
  noop            Boolean   @default(false)
  /// Serialized write order, assigned at INSERT after the Bot lock. createdAt
  /// is transaction-start time and can disagree with commit order under lock
  /// waits, so all ordering goes through seq.
  seq             BigInt    @default(autoincrement())
  beforeMode      String
  beforeBodyColor String @default("ink")
  beforeCharacter String?
  beforeColor     String
  afterMode       String
  afterBodyColor String @default("ink")
  afterCharacter  String?
  afterColor      String
  createdAt       DateTime  @default(now())
  undoneAt        DateTime?

  @@index([botId, seq])
  @@map("bot_avatar_changes")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  spaces      Space[]

  @@unique([slug])
  @@map("organization")
}

model ActionApprovalRule {
  id              String   @id @default(cuid())
  spaceId         String
  space           Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdByUser   User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  effect          String
  matchKind       String
  matchValue      String
  createdAt       DateTime @default(now())

  @@unique([spaceId, createdByUserId, effect, matchKind, matchValue])
  @@index([spaceId, createdByUserId])
  @@map("action_approval_rules")
}

model ActionAutoReviewPreference {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([spaceId, userId])
  @@map("action_auto_review_preferences")
}

model Member {
  id               String        @id
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             String
  createdAt        DateTime
  spaceMemberships SpaceMember[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Space {
  aiDataConsents AiDataConsent[]
  id                          String                       @id
  organizationId              String
  organization                Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                        String
  isDefault                   Boolean                      @default(false)
  createdByUserId             String?
  createdByUser               User?                        @relation("SpaceCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt                   DateTime                     @default(now())
  deletingAt                  DateTime?
  deletionClaimId             String?
  memberships                 SpaceMember[]
  bots                        Bot[]
  botSections                 BotSection[]
  botDeletions                BotDeletion[]
  threads                     Thread[]
  events                      Event[]
  tasks                       Task[]
  runs                        Run[]
  routines                    Routine[]
  scratchpadItems             ScratchpadItem[]
  taughtSkills                TaughtSkill[]
  agentSkills                 AgentSkill[]
  connections                 Connection[]
  capabilities                CapabilityInstall[]
  memoryDocuments             MemoryDocument[]
  agentHomes                  AgentHome[]
  browserProfiles             BrowserProfile[]
  artifacts                   Artifact[]
  usageRecords                UsageRecord[]
  notificationPreferences     NotificationPreference[]
  computers                   Computer[]
  externalEffects             ExternalEffect[]
  mcpServers                  McpServer[]
  mcpOAuthSessions            McpOAuthSession[]
  botMcpServers               BotMcpServer[]
  messagingIdentities         MessagingIdentity[]
  actionApprovalRules         ActionApprovalRule[]
  actionAutoReviewPreferences ActionAutoReviewPreference[]
  memoryConfig                SpaceMemoryConfig?
  memoryFacts                 MemoryFact[]
  memoryShards                MemoryShard[]
  contextSummaries            ContextSummary[]
  memoryModelUsages           MemoryModelUsage[]
  memoryPolicy                SpaceMemoryPolicy?
  secrets                     Secret[]
  chatGroups                  ChatGroup[]
  botSecrets BotSecret[]
  externalConversations       ExternalConversation[]
  agentSecrets                AgentSecret[]

  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@index([createdByUserId])
  @@map("spaces")
}

model SpaceMember {
  id               String                 @id
  spaceId          String
  organizationId   String
  space            Space                  @relation(fields: [spaceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  userId           String
  member           Member                 @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)
  role             String                 @default("member")
  createdAt        DateTime
  modelPreferences SpaceModelPreference[]
  voicePreferences SpaceVoicePreference[]
  aiDataConsents AiDataConsent[]

  @@unique([spaceId, userId])
  @@index([organizationId, userId])
  @@index([userId, createdAt])
  @@map("space_members")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model DeploymentSettings {
  id                              String   @id @default("default")
  ownerUserId                     String?
  signupsEnabled                  Boolean  @default(true)
  signupAllowlist                 String   @default("")
  signupPolicyInitialized         Boolean  @default(false)
  defaultModelProvider            String?
  defaultModelId                  String?
  deploymentModelCredentialCipher String?
  computerHost                    String?
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  @@map("deployment_settings")
}

model UserModelCredential {
  id          String                 @id @default(cuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String
  label       String
  secretId    String
  supportsImages Boolean              @default(false)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  preferences SpaceModelPreference[]

  @@unique([id, userId])
  @@index([userId, provider, updatedAt])
  @@map("user_model_credentials")
}

model UserVoiceCredential {
  id          String                 @id @default(cuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String
  secretId    String
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  preferences SpaceVoicePreference[]

  @@unique([id, userId])
  @@index([userId, provider, updatedAt])
  @@map("user_voice_credentials")
}

model SpaceModelPreference {
  id           String              @id @default(cuid())
  spaceId      String
  userId       String
  spaceMember  SpaceMember         @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  credentialId String
  credential   UserModelCredential @relation(fields: [credentialId, userId], references: [id, userId], onDelete: Cascade)
  modelId      String?
  isDefault    Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([spaceId, userId, credentialId])
  @@index([spaceId, userId, isDefault, updatedAt])
  @@index([credentialId])
  // Partial unique index space_model_preferences_default_key is created in SQL.
  @@map("space_model_preferences")
}

model SpaceVoicePreference {
  id           String              @id @default(cuid())
  spaceId      String
  userId       String
  spaceMember  SpaceMember         @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  credentialId String
  credential   UserVoiceCredential @relation(fields: [credentialId, userId], references: [id, userId], onDelete: Cascade)
  voiceId      String              @default("")
  // Fish speech-model override. Null keeps the deployment default.
  speechModel  String?
  isDefault    Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([spaceId, userId, credentialId])
  @@index([spaceId, userId, isDefault, updatedAt])
  @@index([credentialId])
  // Partial unique index space_voice_preferences_default_key is created in SQL.
  @@map("space_voice_preferences")
}

model Bot {
  screenGeneration Int @default(0)
  id                String            @id @default(cuid())
  spaceId           String
  space             Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId            String
  name              String
  title             String            @default("")
  description       String            @default("")
  instructions      String            @default("")
  capabilityRules    Json?
  color             String
  avatarMode        String            @default("legacy")
  avatarBodyColor   String @default("ink")
  avatarCharacter   String?
  notifyOnFinish    Boolean           @default(true)
  pinned            Boolean           @default(false)
  position          Int               @default(0)
  sectionId         String?
  section           BotSection?       @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  archivedAt        DateTime?
  parentBotId       String?
  spawnKey          String?
  memoryScope       String?
  parent            Bot?              @relation("BotChildren", fields: [parentBotId], references: [id], onDelete: SetNull)
  children          Bot[]             @relation("BotChildren")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  thread            Thread?
  computerId        String?
  computer          Computer?         @relation(fields: [computerId], references: [id], onDelete: SetNull)
  computerSwitching Boolean           @default(false)
  voiceId           String?
  autoSpeak         Boolean           @default(false)
  modelProvider     String?
  modelId           String?
  thinkingLevel     String?
  webhookSecretId   String?
  teamChatAmbientEnabled Boolean @default(false)
  teamChatRules          String  @default("")
  routines          Routine[]
  scratchpadItems   ScratchpadItem[]
  taughtSkills      TaughtSkill[]
  memoryDocuments   MemoryDocument[]
  memoryFacts       MemoryFact[]
  agentHome         AgentHome?
  browserProfile    BrowserProfile?
  artifacts         Artifact[]
  tasks             Task[]
  runs              Run[]
  steeringMessages  SteeringMessage[]
  mcpServers        BotMcpServer[]
  groupMembers      ChatGroupMember[]
  ledGroups         ChatGroup[]         @relation("ChatGroupLeadBot")
  botSecrets BotSecret[]

  externalConversations ExternalConversation[]
  avatarChanges BotAvatarChange[]

  @@unique([spaceId, spawnKey])
  @@index([spaceId, userId, archivedAt, pinned, updatedAt])
  @@index([sectionId])
  @@index([computerId])
  @@index([parentBotId])
  @@index([userId, avatarMode, avatarCharacter])
  @@map("bots")
}

model BotSection {
  id        String      @id @default(cuid())
  spaceId   String
  space     Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  position  Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  bots      Bot[]
  groups    ChatGroup[]

  @@unique([spaceId, userId, name])
  @@index([spaceId, userId, position, createdAt])
  @@map("bot_sections")
}

model BotDeletion {
  id                String   @id
  spaceId           String
  space             Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name              String
  deletedByUserId   String
  memoriesPreserved Boolean
  deletedAt         DateTime @default(now())

  @@index([spaceId, deletedAt])
  @@map("bot_deletions")
}

model ChatGroup {
  id         String            @id @default(cuid())
  spaceId    String
  space      Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId     String
  name       String
  pinned     Boolean           @default(false)
  sectionId  String?
  section    BotSection?       @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  /// Product Harness routing/coordination fallback owner. Nullable: membership and
  /// liveness are validated at routing time and self-healed to an active member.
  leadBotId  String?
  leadBot    Bot?              @relation("ChatGroupLeadBot", fields: [leadBotId], references: [id], onDelete: SetNull)
  archivedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  members    ChatGroupMember[]
  thread     Thread?
  artifacts  Artifact[]

  @@index([spaceId, userId, archivedAt, pinned, updatedAt])
  @@index([sectionId])
  @@map("chat_groups")
}

model ChatGroupMember {
  id        String    @id @default(cuid())
  groupId   String
  group     ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  botId     String
  bot       Bot       @relation(fields: [botId], references: [id], onDelete: NoAction)
  createdAt DateTime  @default(now())

  @@unique([groupId, botId])
  @@index([botId])
  @@map("chat_group_members")
}

model Thread {
  id                          String     @id @default(cuid())
  spaceId                     String
  space                       Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId                       String?    @unique
  bot                         Bot?       @relation(fields: [botId], references: [id], onDelete: Cascade)
  groupId                     String?    @unique
  group                       ChatGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  externalConversationId      String?    @unique
  externalConversation        ExternalConversation? @relation(fields: [externalConversationId], references: [id], onDelete: Cascade)
  userId                      String
  createdAt                   DateTime   @default(now())
  nextEventSeq                Int        @default(0)
  nextMessageSeq              Int        @default(0)
  historyCompactedUpToSeq     Int?
  historyCompactionSummary    String?    @db.Text
  historyCompactionGeneration Int        @default(0)
  unread                      Boolean    @default(false)
  messages                    Message[]
  events                      Event[]
  tasks                       Task[]
  runs                        Run[]
  routines                    Routine[]
  compactionRevisions         ThreadCompactionRevision[]
  extractionCursor            MemoryExtractionCursor?

  @@index([spaceId])
  @@map("threads")
}

model Message {
  id               String    @id @default(cuid())
  threadId         String
  thread           Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  seq              Int
  role             String
  /// Trusted server entry path. Existing rows remain unknown after migration.
  originKind       String    @default("unknown")
  /// Set only when an authenticated or linked sender identity is known.
  authorUserId     String?
  blocks           Json
  botId            String?
  replyToMessageId String?
  replyQuote       String?
  replyTo          Message?  @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          Message[] @relation("MessageReplies")
  runId            String?
  clientNonce      String?
  sourceRuns            Run[]             @relation("RunSourceMessage")
  externalTranscriptFor  ExternalMessage?
  steeringMessages SteeringMessage[]
  createdAt        DateTime  @default(now())

  @@unique([threadId, seq])
  @@unique([threadId, clientNonce])
  @@index([threadId, seq])
  @@index([replyToMessageId])
  @@index([runId, seq])
  @@map("messages")
}

model Event {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  botId     String
  seq       Int
  type      String
  payload   Json
  runId     String?
  schemaVersion Int @default(1)
  causationId   String?
  parentRunId   String?
  createdAt DateTime @default(now())

  @@unique([threadId, seq])
  @@index([spaceId, createdAt])
  @@index([threadId, seq])
  @@index([threadId, type, createdAt])
  @@index([runId, type, seq])
  @@map("events")
}

model Task {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId     String
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    String
  prompt    String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs      Run[]

  @@index([spaceId, botId])
  @@map("tasks")
}

model Run {
  id                   String           @id @default(cuid())
  spaceId              String
  space                Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId                String
  bot                  Bot              @relation(fields: [botId], references: [id], onDelete: Cascade)
  threadId             String
  thread               Thread           @relation(fields: [threadId], references: [id], onDelete: Cascade)
  taskId               String
  task                 Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId               String
  status               String
  waitKind             String?
  waitStartedAt        DateTime?
  trigger              String
  /// Immutable Product Harness decision captured when the Run was created.
  orchestration        Json?
  budgetOverride       Json?
  modelProvider        String?
  modelId              String?
  error                String?
  leaseOwner           String?
  leaseFence           Int              @default(0)
  leaseExpiresAt       DateTime?
  retryAt              DateTime?
  checkpoint           String?
  // HISTORY-001: visible-transition counter, maintained by the runs_snapshot_rev
  // trigger (bumps only when a snapshot-visible column actually changes).
  snapshotRev          Int              @default(0)
  clientNonce          String?
  sourceMessageId      String?
  sourceMessage        Message?         @relation("RunSourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)
  routineId            String?
  routine              Routine?         @relation(fields: [routineId], references: [id], onDelete: SetNull)
  startedAt            DateTime?
  completedAt          DateTime?
  botOutcomeReturnedAt DateTime?
  messagingMirroredAt  DateTime?
  teamChatMirroredAt   DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  attempts             Attempt[]
  effects              ExternalEffect[]
  usageRecords         UsageRecord[]
  steeringMessages     SteeringMessage[]
  externalMessage      ExternalMessage?
  backgroundTasks       BackgroundAgentTask[]
  avatarFailureReceipts AvatarFailureReceipt[]
  deliverySourceRecords DeliveryRecord[] @relation("DeliverySourceRun")
  plan                 RunPlan?
  steps                RunStep[]
  todos                RunTodo[]
  /// Direct predecessor of a manual retry (new Run). Unique so one hop has one successor.
  retryOfRunId         String?          @unique
  retryOfRun           Run?             @relation("RunManualRetry", fields: [retryOfRunId], references: [id], onDelete: Restrict)
  manualRetrySuccessor Run?             @relation("RunManualRetry")

  @@unique([spaceId, clientNonce])
  @@index([status, leaseExpiresAt])
  @@index([status, retryAt])
  @@index([status, updatedAt, id])
  @@index([status, waitStartedAt, id])
  @@index([botOutcomeReturnedAt, status])
  @@index([trigger, status, messagingMirroredAt, updatedAt])
  @@index([trigger, status, teamChatMirroredAt, updatedAt])
  @@index([spaceId, botId])
  @@index([sourceMessageId])
  @@index([threadId, status, createdAt])
  @@index([routineId])
  @@map("runs")
}

model RunPlan {
  runId       String            @id
  run         Run               @relation(fields: [runId], references: [id], onDelete: Cascade)
  planId      String            @unique
  threadGeneration Int
  revision    Int
  current     Json
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  revisions   RunPlanRevision[]

  @@map("run_plans")
}

model RunPlanRevision {
  id         String   @id
  runId      String
  plan       RunPlan  @relation(fields: [runId], references: [runId], onDelete: Cascade)
  revision   Int
  snapshot   Json
  eventSeq   Int
  toolExecutionId String
  createdAt  DateTime @default(now())

  @@unique([runId, revision])
  @@unique([runId, toolExecutionId])
  @@index([runId, revision(sort: Desc)])
  @@map("run_plan_revisions")
}

model RunStep {
  runId            String
  run              Run               @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepId           String
  threadGeneration Int
  revision         Int
  sortOrder        Int
  current          Json
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  mutations        RunStepMutation[]

  @@id([runId, stepId])
  @@index([runId, sortOrder])
  @@map("run_steps")
}

model RunStepMutation {
  id              String  @id @default(cuid())
  runId           String
  stepId          String
  step            RunStep @relation(fields: [runId, stepId], references: [runId, stepId], onDelete: Cascade)
  toolExecutionId String
  revision        Int
  snapshot        Json
  eventSeq        Int
  createdAt       DateTime @default(now())

  @@unique([runId, toolExecutionId])
  @@unique([runId, stepId, revision])
  @@index([runId, stepId, revision(sort: Desc)])
  @@map("run_step_mutations")
}

model RunTodo {
  runId            String
  run              Run               @relation(fields: [runId], references: [id], onDelete: Cascade)
  todoId           String
  threadGeneration Int
  revision         Int
  sortOrder        Int
  current          Json
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  mutations        RunTodoMutation[]

  @@id([runId, todoId])
  @@index([runId, sortOrder])
  @@map("run_todos")
}

model RunTodoMutation {
  id              String  @id @default(cuid())
  runId           String
  todoId          String
  todo            RunTodo @relation(fields: [runId, todoId], references: [runId, todoId], onDelete: Cascade)
  toolExecutionId String
  revision        Int
  snapshot        Json
  eventSeq        Int
  createdAt       DateTime @default(now())

  @@unique([runId, toolExecutionId])
  @@unique([runId, todoId, revision])
  @@map("run_todo_mutations")
}

/// Product projection only. AgentScope WorkspaceTaskRepository owns execution and reminders.
/** A failed Run stops claiming the Bot's avatar after its focused detail was viewed. */
model AvatarFailureReceipt {
  userId  String
  runId   String
  spaceId String
  seenAt  DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  run     Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@id([userId, runId])
  @@index([spaceId, userId])
  @@map("avatar_failure_receipts")
}

model BackgroundAgentTask {
  taskId       String    @id
  parentRunId  String
  parentRun    Run       @relation(fields: [parentRunId], references: [id], onDelete: Cascade)
  userId       String
  spaceId      String
  botId        String
  threadId     String
  threadGeneration Int @default(0)
  agentId      String
  sessionId    String
  toolNames    Json
  status       String
  startedAt    DateTime  @default(now())
  heartbeatAt  DateTime  @default(now())
  finishedAt   DateTime?
  expiresAt    DateTime
  result       String?   @db.Text
  error        String?   @db.Text

  @@index([spaceId, threadId, status])
  @@index([parentRunId])
  @@index([threadId, status])
  @@index([botId, status])
  @@map("background_agent_tasks")
}

model DeliveryRecord {
  id               String    @id @default(cuid())
  runId            String
  sourceRun        Run       @relation("DeliverySourceRun", fields: [runId], references: [id], onDelete: Cascade)
  backgroundTaskId String?
  threadId         String
  threadGeneration Int
  kind             String
  status           String    @default("pending")
  idempotencyKey   String    @unique
  attempts         Int       @default(0)
  lastError        String?   @db.Text
  claimedBy        String?
  deliveryRunId    String?
  nextAttemptAt    DateTime  @default(now())
  createdAt        DateTime  @default(now())
  deliveredAt      DateTime?

  @@index([status, nextAttemptAt])
  @@index([threadId, status])
  @@index([deliveryRunId])
  @@index([backgroundTaskId])
  @@map("delivery_records")
}

model SteeringMessage {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  botId     String
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId    String
  runId     String?
  run       Run?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  /// Set when a pending row must resume as this trigger so its reply can be delivered.
  originTrigger String?
  claimedAt DateTime?
  createdAt DateTime @default(now())

  @@unique([messageId, botId])
  @@index([botId, runId, createdAt])
  @@index([runId])
  @@map("steering_messages")
}

model Attempt {
  id         String    @id @default(cuid())
  runId      String
  run        Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  fence      Int
  status     String
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@unique([runId, fence])
  @@map("attempts")
}

// Deliberately independent of chat/user cascades: the worker must still be able
// to cancel remote work after its originating chat or account is deleted.
// A row's presence means the remote DELETE is still pending. Success, including
// HTTP 404, deletes the row. There is no foreign key to Run, Bot, Thread, Group,
// User, or BackgroundAgentTask.
model ExecutionRevocation {
  id        String   @id @default(cuid())
  /// "run_abort" or "background_task".
  kind      String
  /// runId for run_abort, taskId for background_task. Never null, so the unique key is stable.
  subjectId String
  runId     String   @default("")
  taskId    String   @default("")
  userId    String   @default("")
  spaceId   String   @default("")
  botId     String   @default("")
  threadId  String   @default("")
  attempts  Int      @default(0)
  lastError String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, subjectId])
  @@index([createdAt])
  @@map("execution_revocations")
}

// Deliberately independent of chat/user cascades: the worker must still be able
// to cancel remote work after its originating chat or account is deleted.
model CloudAgent {
  id                  String   @id @default(uuid())
  operationKey        String   @unique
  providerKey         String
  spaceId             String
  userId              String
  botId               String
  threadId            String
  messageId           String?
  remoteId            String?
  latestRunId         String?
  title               String
  status              String   @default("running")
  url                 String   @default("")
  branch              String?
  prUrl               String?
  launchRequest       Json
  launchDispatched    Boolean  @default(false)
  followup            Json?
  followupDispatching Boolean  @default(false)
  cancelRequested     Boolean  @default(false)
  generation          Int      @default(0)
  wakeGeneration      Int      @default(-1)
  version             Int      @default(0)
  leaseToken          String?
  leaseExpiresAt      DateTime?
  nextPollAt          DateTime? @default(now())
  errorCount          Int      @default(0)
  createdAt           DateTime @default(now())

  @@index([providerKey, nextPollAt])
  @@index([spaceId, userId, id])
  @@map("cloud_agents")
}

model ExternalEffect {
  id             String   @id @default(cuid())
  spaceId        String
  space          Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  runId          String
  run            Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind           String
  idempotencyKey String
  /// Backend-assigned logical operation id. Stable across a manual-retry chain.
  /// Distinct from Run/Attempt/toolCallId/transport nonce. Several effect rows
  /// (one hop each) may share one operationId. New independent ops get a new id.
  operationId    String   @default(cuid())
  status         String
  request        Json
  result         Json?
  reviewDecision String?
  reviewReason   String?
  reviewModel    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([idempotencyKey])
  @@index([runId, status])
  @@index([operationId])
  @@map("external_effects")
}

// Addressable approval or input request. No foreign key to Run, Message, or
// ExternalEffect: deleting those rows must not erase a terminal audit record.
// pendingRunKey is the run id while pending and null afterward, so a run cannot
// hold two pending interventions and terminal rows do not collide.
model Intervention {
  id               String    @id
  revision         Int       @default(1)
  kind             String
  status           String
  spaceId          String
  threadId         String
  runId            String
  attemptId        String
  botId            String
  messageId        String
  pendingRunKey    String?   @unique
  expiresAt        DateTime?
  resolvedAt       DateTime?
  resolvedByUserId String?
  supersededById   String?
  agentId          String?
  backgroundTaskId String?
  inputMode        String?
  inputPurpose     String?
  inputActions     Json?
  presentation     Json?
  effectId         String?
  decision         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  submissions      InterventionSubmission[]

  @@index([threadId, status])
  @@index([runId, status])
  @@index([messageId])
  @@map("interventions")
}

model InterventionSubmission {
  id                 String       @id @default(cuid())
  interventionId     String
  intervention       Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  clientSubmissionId String
  createdAt          DateTime     @default(now())

  @@unique([interventionId, clientSubmissionId])
  @@index([interventionId])
  @@map("intervention_submissions")
}

model Routine {
  id             String    @id @default(cuid())
  spaceId        String
  space          Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId          String
  bot            Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId         String
  threadId       String?
  thread         Thread?   @relation(fields: [threadId], references: [id], onDelete: SetNull)
  name           String
  prompt         String
  crons          String[]
  timezone       String    @default("UTC")
  active         Boolean   @default(false)
  notify         Boolean   @default(true)
  webhookEnabled Boolean   @default(false)
  githubEnabled  Boolean   @default(false)
  messageProvider String?
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  runs           Run[]

  @@index([active, nextRunAt])
  @@index([spaceId, botId])
  @@map("routines")
}

model ScratchpadItem {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId     String
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId    String
  title     String
  status    String   @default("open")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceId, botId, status])
  @@index([spaceId, botId, updatedAt])
  @@map("scratchpad_items")
}

model TaughtSkill {
  id        String    @id @default(cuid())
  spaceId   String
  space     Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId     String
  bot       Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId    String
  name      String    @default("")
  goal      String
  status    String
  playbook  Json      @default("{}")
  recording Json      @default("{\"events\":[],\"snapshots\":[]}")
  startedAt DateTime?
  expiresAt DateTime?
  stoppedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([spaceId, botId])
  @@index([spaceId, botId, status])
  // Partial unique index taught_skills_botId_recording_key is created in SQL:
  // one recording session per bot.
  @@map("taught_skills")
}

/// Claude Agent Skills: SKILL.md recipes shared across assistants (not per-bot).
/// The Pi runtime already understands this format; we persist and inject them.
/// Distinct from TaughtSkill (demo/record playbooks).
model AgentSkill {
  id          String   @id @default(cuid())
  spaceId     String
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  description String
  content     String
  /// user | builtin | plugin — only user skills are writable via API/tools.
  source      String   @default("user")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([spaceId, userId])
  // Case-insensitive unique index agent_skills_spaceId_userId_name_lower_key is created in SQL.
  @@map("agent_skills")
}

model Connection {
  id          String   @id @default(cuid())
  spaceId     String
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId      String
  connectorId String   @default("composio")
  provider    String
  displayName String
  status      String
  secretId    String?
  providerRef String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([spaceId, userId, connectorId])
  @@map("connections")
}

model CapabilityInstall {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String
  kind      String
  name      String
  source    String
  version   String?
  digest    String?
  secretId  String?
  config    Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([spaceId, userId])
  @@map("capability_installs")
}

model MemoryDocument {
  id        String           @id @default(cuid())
  spaceId   String
  space     Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String
  botId     String?
  bot       Bot?             @relation(fields: [botId], references: [id], onDelete: Cascade)
  scope     String
  path      String
  content   String
  revision  Int              @default(1)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  revisions MemoryRevision[]

  @@unique([spaceId, scope, botId, path])
  @@index([spaceId, userId])
  @@map("memory_documents")
}

model MemoryRevision {
  id             String         @id @default(cuid())
  documentId     String
  document       MemoryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  revision       Int
  content        String
  sourceRunId    String?
  sourceThreadId String?
  createdAt      DateTime       @default(now())

  @@unique([documentId, revision])
  @@map("memory_revisions")
}

/// One independently revocable proposition or preference (ME-01). Dedupe for
/// active and candidate rows lives in partial unique indexes in the SQL
/// migration (Prisma cannot express `WHERE state = ...` uniques).
model MemoryFact {
  id                    String    @id @default(cuid())
  spaceId               String
  space                 Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  /// Personal facts belong to one user inside the Space; shared facts keep the original creator.
  ownerUserId           String
  botId                 String?
  bot                   Bot?      @relation(fields: [botId], references: [id], onDelete: Cascade)
  /// bot | user | space. scopeKey is built only from backend-validated entity ids.
  scopeKind             String
  scopeKey              String
  /// Server-computed identity of the proposition within its scope; not a plain body hash.
  canonicalKey          String
  /// explicit_preference | correction | workflow | stable_fact | legacy_document
  kind                  String
  /// Summarized wording; never a verbatim transcript of user messages.
  text                  String
  language              String?
  /// Restricted structured literals (commands, paths, names). Injected as escaped data.
  literalValues         Json?
  /// user_direct | user_confirmed | model_candidate | legacy_import
  origin                String
  /// candidate | active | superseded | deleted | rejected
  state                 String
  revision              Int       @default(1)
  supersedesFactId      String?
  /// Set when this fact was promoted from another fact; keeps the source link.
  promotionSourceFactId String?
  /// Legacy MemoryDocument this fact was imported from (one-way, per-item confirmation).
  sourceDocumentId      String?
  learnedAt             DateTime  @default(now())
  validFrom             DateTime?
  expiresAt             DateTime?
  lastConfirmedAt       DateTime?
  createdBy             String
  lastChangedBy         String
  sourceRunId           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  revisions             MemoryFactRevision[]
  evidence              MemoryEvidence[]

  @@index([spaceId, scopeKind, scopeKey, state])
  @@index([spaceId, scopeKind, scopeKey, canonicalKey])
  @@index([spaceId, ownerUserId, state])
  @@index([sourceDocumentId])
  @@index([state, expiresAt])
  @@map("memory_facts")
}

/// Per-revision audit. `text` is nullable so a user delete can purge bodies
/// from every revision while keeping ids, actor, revision and action.
model MemoryFactRevision {
  id            String     @id @default(cuid())
  factId        String
  fact          MemoryFact @relation(fields: [factId], references: [id], onDelete: Cascade)
  revision      Int
  state         String
  text          String?
  kind          String
  literalValues Json?
  changedBy     String
  reason        String?
  createdAt     DateTime   @default(now())

  @@unique([factId, revision])
  @@map("memory_fact_revisions")
}

/// Trusted-source evidence for a fact. sourceDigest is a server-keyed HMAC,
/// never a plain hash of guessable content. messageId has no FK: thread clear
/// deletes messages and must explicitly invalidate evidence in the same
/// transaction instead of relying on SET NULL.
model MemoryEvidence {
  id               String     @id @default(cuid())
  factId           String
  fact             MemoryFact @relation(fields: [factId], references: [id], onDelete: Cascade)
  threadId         String
  threadGeneration Int
  messageId        String?
  messageSeq       Int
  authorUserId     String
  /// human_web | human_messaging | user_edit | user_correction | legacy_document
  originKind       String
  /// user_message | user_edit | explicit_instruction | legacy_document
  evidenceType     String
  sourceDigest     String
  accessible       Boolean    @default(true)
  capturedAt       DateTime   @default(now())

  @@index([factId])
  @@index([threadId, threadGeneration])
  @@map("memory_evidence")
}

/// One shard per (space, scope); version is monotonic and profileMarkdown is a
/// rebuildable projection readable only when profileVersion == version.
model MemoryShard {
  id              String    @id @default(cuid())
  spaceId         String
  space           Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  scopeKind       String
  scopeKey        String
  version         Int       @default(0)
  profileMarkdown String?
  profileVersion  Int       @default(-1)
  lastRebuiltAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([spaceId, scopeKind, scopeKey])
  @@map("memory_shards")
}

/// Per-recipient projection of the visible shards. Readable only when every
/// sourceVersions entry matches the current shard version.
model ContextSummary {
  id                  String   @id @default(cuid())
  spaceId             String
  space               Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  recipientUserId     String
  recipientBotId      String
  /// { shardId: version } covering every input shard.
  sourceVersions      Json
  sourceVersionDigest String
  content             String
  summaryModel        String
  promptVersion       String
  tokenEstimate       Int
  /// ready | failed
  status              String    @default("ready")
  generatedAt         DateTime  @default(now())
  createdAt           DateTime  @default(now())

  @@unique([spaceId, recipientUserId, recipientBotId, sourceVersionDigest])
  @@index([spaceId, recipientUserId, recipientBotId])
  @@map("context_summaries")
}

/// Durable outbox for memory jobs (summary rebuild, index cleanup/projection).
/// No FKs by design (ExecutionRevocation pattern); presence of a row means
/// pending, success deletes it.
model MemoryJobOutbox {
  id                  String    @id @default(cuid())
  /// summary_rebuild | index_projection | index_cleanup
  kind                String
  spaceId             String
  targetId            String
  payload             Json
  sourceVersionDigest String    @default("")
  attempts            Int       @default(0)
  nextAttemptAt       DateTime  @default(now())
  lastError           String?
  claimedBy           String?
  claimedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([kind, targetId, sourceVersionDigest])
  @@index([nextAttemptAt])
  @@map("memory_job_outbox")
}

/// Per-thread extraction high-watermark. generation guards against late jobs
/// writing back after a thread clear.
model MemoryExtractionCursor {
  id               String    @id @default(cuid())
  spaceId          String
  userId           String
  botId            String?
  threadId         String    @unique
  thread           Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadGeneration Int       @default(0)
  highWatermarkSeq Int       @default(-1)
  lastRunAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([spaceId, userId])
  @@map("memory_extraction_cursors")
}

/// Daily auxiliary model usage per user and purpose, for quota enforcement and
/// honest cost accounting (tokens and calls; no billing data exists).
model MemoryModelUsage {
  id               String   @id @default(cuid())
  spaceId          String
  space            Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId           String
  /// UTC day, time-truncated.
  day              DateTime
  /// extraction | summary | compaction
  purpose          String
  calls            Int      @default(0)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([spaceId, userId, day, purpose])
  @@map("memory_model_usage")
}

/// Per-space automatic inference policy: off (default) | on | paused.
model SpaceMemoryPolicy {
  spaceId        String   @id
  space          Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  autoExtraction String   @default("off")
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("space_memory_policies")
}

/// Auditable application-layer compaction revisions (ME-02 M4). Thread keeps
/// the current pointer for compatibility; this chain records coverage and the
/// pinned model identity per revision.
model ThreadCompactionRevision {
  id                  String   @id @default(cuid())
  threadId            String
  thread              Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  generation          Int
  fromSeqExclusive    Int
  toSeqInclusive      Int
  previousRevisionId  String?
  summary             String
  inputDigest         String
  sourceRunId         String?
  modelProvider       String
  modelId             String
  promptVersion       String
  includesToolResults Boolean  @default(false)
  createdAt           DateTime @default(now())

  @@unique([threadId, generation, toSeqInclusive])
  @@index([threadId])
  @@map("thread_compaction_revisions")
}

model AgentHome {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId     String   @unique
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId    String
  revision  String   @default("empty")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("agent_homes")
}

model BrowserProfile {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId     String   @unique
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId    String
  secretId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("browser_profiles")
}

model ComputerUpdate {
  action     String   @default("update")
  id         String   @id @default(cuid())
  computerId String
  computer   Computer @relation(fields: [computerId], references: [id], onDelete: Cascade)
  botId      String
  status     String   @default("queued")
  stage      String   @default("preparing")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([computerId, createdAt])
  @@index([status, updatedAt])
  @@map("computer_updates")
}

model Computer {
  screenGeneration Int @default(0)
  id                      String                   @id @default(cuid())
  spaceId                 String
  space                   Space                    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId                  String
  scope                   String                   @default("team")
  scopeKey                String                   @unique
  homeKey                 String                   @unique
  homeRevision            String                   @default("empty")
  kind                    String
  providerRef             String?
  state                   String                   @default("stopped")
  controlHolder           String                   @default("none")
  controlLeaseId          String?
  controlLeaseExpiresAt   DateTime?
  controlBotId            String?
  controlRunId            String?
  controlFence            Int                      @default(0)
  executionRunId          String?
  executionBotId          String?
  executionLeaseExpiresAt DateTime?
  executionFence          Int                      @default(0)
  screenUrl               String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
